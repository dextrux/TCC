  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Como Conectar\n\nO Host deve clicar no bot\xE3o GYM e com isso vai copiar
    o seu ID automaticamente para a \xE1rea de transferencia. Ele deve enviar o ID
    copiado para o cliente.\n\r\nO Cliente deve copiar o ID do Host e colar ele no
    espa\xE7o em branco abaixo do bot\xE3o GYM. Depois disso, apertar o bot\xE3o
    GYM CLIENT.\r\n\r\nSe feito corretamente, os dois players ser\xE3o spawnados
    na cena. Por enquanto eles s\xF3 spawnam com a camera, mas sem movimentacao."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
